{
  "_comment": "Amazon Brazil product parser. Requests may be refused; CAPTCHA is never bypassed.",
  "store": {
    "id": "amazon_br",
    "name": "Amazon Brasil",
    "base_url": "https://www.amazon.com.br",
    "currency": "BRL",
    "image_hosts": [
      "m.media-amazon.com"
    ]
  },
  "parser": "amazon_br",
  "request": {
    "method": "GET",
    "headers": {
      "Accept-Language": "pt-BR,pt;q=0.9"
    },
    "timeout": 20,
    "rate_limit_seconds": 300
  },
  "price": {
    "strategies": [
      {
        "name": "one_time_purchase",
        "type": "css",
        "selector": "#buybox .a-accordion-active .apex-pricetopay-value .a-offscreen",
        "transform": "comma_decimal_to_float"
      }
    ]
  },
  "product_name": {
    "strategies": [
      {
        "name": "product_title",
        "type": "css",
        "selector": "#productTitle"
      }
    ]
  },
  "availability": {
    "strategies": [
      {
        "name": "availability",
        "type": "css",
        "selector": "#availability"
      }
    ]
  },
  "search": {
    "url_template": "https://www.amazon.com.br/s?k={query}",
    "strategies": [
      {
        "name": "amazon_search_cards",
        "type": "html_cards",
        "card_selector": "[data-component-type=\"s-search-result\"][data-asin]",
        "mapping": {
          "name_selector": "h2 span",
          "url_source": "data-asin",
          "url_prefix": "https://www.amazon.com.br/dp/",
          "asin_pattern": "^[A-Z0-9]{10}$",
          "price_selector": ".a-price:not(.a-text-price) .a-offscreen",
          "image_selector": "img.s-image",
          "image_source": "src"
        }
      }
    ],
    "pagination": {
      "type": "query_cursor",
      "page_param": "page",
      "start_page": 1,
      "next_selector": "a.s-pagination-next",
      "cache_seconds": 300,
      "request_spacing_seconds": 3
    }
  },
  "product_image": {
    "strategies": [
      {
        "name": "primary_image",
        "type": "css",
        "selector": "#landingImage"
      },
      {
        "name": "og_image",
        "type": "meta",
        "attribute": "property",
        "value": "og:image",
        "extract": "content"
      }
    ]
  }
}
